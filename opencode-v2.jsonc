{
  "$schema": "https://opencode.ai/config.json",
  "mcp": {
    "servers": {
      "headroom": {
        "type": "local",
        "command": [
          "/Users/lasn/.local/bin/headroom",
          "mcp",
          "serve"
        ],
        "disabled": false
      },
      "serena": {
        "type": "local",
        "command": [
          "uvx",
          "--from",
          "serena-agent",
          "serena",
          "start-mcp-server",
          "--project-from-cwd",
          "--context",
          "agent",
          "--open-web-dashboard",
          "False"
        ],
        "disabled": false
      },
      "linear": {
        "type": "remote",
        "url": "https://mcp.linear.app/mcp",
        "oauth": {}
      },
      "servicenow": {
        "type": "local",
        "command": [
          "uv",
          "run",
          "--directory",
          "/Users/lasn/Projects/servicenow-platform-mcp",
          "servicenow-platform-mcp"
        ],
        "environment": {
          "SERVICENOW_INSTANCE_URL": "{env:SERVICENOW_MCP_DEV_INSTANCE_URL}",
          "SERVICENOW_API_KEY": "{env:SERVICENOW_MCP_DEV_API_KEY}",
          "MCP_TOOL_PACKAGE": "{env:SERVICENOW_MCP_TOOL_PACKAGE}",
          "SERVICENOW_ENV": "{env:SERVICENOW_MCP_DEV_ENV}",
          "SCRIPT_ALLOWED_ROOT": "/Users/lasn/Projects/servicenow-development/"
        },
        "disabled": false
      },
      "context7": {
        "type": "remote",
        "url": "https://mcp.context7.com/mcp",
        "timeout": {
          "catalog": 10000,
          "execution": 10000
        },
        "disabled": false
      },
      "exa": {
        "type": "remote",
        "url": "https://mcp.exa.ai/mcp",
        "timeout": {
          "catalog": 10000,
          "execution": 10000
        },
        "disabled": false
      },
      "gh_grep": {
        "type": "remote",
        "url": "https://mcp.grep.app",
        "timeout": {
          "catalog": 10000,
          "execution": 10000
        },
        "disabled": false
      },
      "playwright": {
        "type": "local",
        "command": [
          "mise",
          "exec",
          "--",
          "npx",
          "-y",
          "@playwright/mcp@latest",
          "--headless",
          "--isolated",
          "--browser=chromium",
          "--block-service-workers",
          "--image-responses=omit",
          "--output-dir=/tmp/playwright-mcp-research"
        ],
        "disabled": false
      },
      "pdf-reader": {
        "type": "local",
        "command": [
          "uvx",
          "pdf-mcp"
        ],
        "disabled": false
      },
      "atlassian": {
        "type": "remote",
        "url": "https://mcp.atlassian.com/v2/mcp",
        "disabled": false
      }
    }
  },
  "lsp": {
    "pyright": {
      "disabled": true
    },
    "basedpyright": {
      "command": [
        "basedpyright-langserver",
        "--stdio"
      ],
      "extensions": [
        ".py",
        ".pyi"
      ]
    }
  },
  "plugins": [
    "@plannotator/opencode@0.25.1",
    "@franlol/opencode-md-table-formatter@0.0.6"
  ],
  "permissions": [
    {
      "action": "read",
      "resource": "*",
      "effect": "allow"
    },
    {
      "action": "glob",
      "resource": "*",
      "effect": "allow"
    },
    {
      "action": "edit",
      "resource": "*",
      "effect": "deny"
    },
    {
      "action": "shell",
      "resource": "*",
      "effect": "ask"
    },
    {
      "action": "shell",
      "resource": "rm *",
      "effect": "deny"
    },
    {
      "action": "shell",
      "resource": "sudo *",
      "effect": "deny"
    },
    {
      "action": "shell",
      "resource": "shutdown*",
      "effect": "deny"
    },
    {
      "action": "shell",
      "resource": "reboot*",
      "effect": "deny"
    },
    {
      "action": "wow-api-lookup",
      "resource": "*",
      "effect": "deny"
    },
    {
      "action": "wow-wiki-fetch",
      "resource": "*",
      "effect": "deny"
    },
    {
      "action": "wow-event-info",
      "resource": "*",
      "effect": "deny"
    },
    {
      "action": "wow-blizzard-source",
      "resource": "*",
      "effect": "deny"
    },
    {
      "action": "subagent",
      "resource": "*",
      "effect": "deny"
    },
    {
      "action": "webfetch",
      "resource": "*",
      "effect": "deny"
    },
    {
      "action": "context7_*",
      "resource": "*",
      "effect": "deny"
    },
    {
      "action": "exa_*",
      "resource": "*",
      "effect": "deny"
    },
    {
      "action": "gh_grep*",
      "resource": "*",
      "effect": "deny"
    },
    {
      "action": "servicenow_*",
      "resource": "*",
      "effect": "deny"
    },
    {
      "action": "playwright_*",
      "resource": "*",
      "effect": "deny"
    },
    {
      "action": "firefly_iii_*",
      "resource": "*",
      "effect": "deny"
    },
    {
      "action": "external_directory",
      "resource": "/Users/lasn/.plannotator/**",
      "effect": "allow"
    },
    {
      "action": "external_directory",
      "resource": "/Users/lasn/.local/share/wow-annotations/**",
      "effect": "allow"
    },
    {
      "action": "external_directory",
      "resource": "/Users/lasn/Projects/**",
      "effect": "allow"
    },
    {
      "action": "external_directory",
      "resource": "/tmp/**",
      "effect": "allow"
    },
    {
      "action": "external_directory",
      "resource": "/home/xerrion/.local/share/wow-annotations/**",
      "effect": "allow"
    },
    {
      "action": "external_directory",
      "resource": "/home/xerrion/.local/share/wow-framexml/**",
      "effect": "allow"
    }
  ],
  "agents": {
    "researcher": {
      "model": "github-copilot/gpt-5.6-sol",
      "request": {
        "body": {
          "temperature": 0.2
        }
      },
      "mode": "subagent",
      "permissions": [
        {
          "action": "edit",
          "resource": "*",
          "effect": "deny"
        },
        {
          "action": "edit",
          "resource": "*",
          "effect": "deny"
        },
        {
          "action": "context7_*",
          "resource": "*",
          "effect": "allow"
        },
        {
          "action": "exa_*",
          "resource": "*",
          "effect": "allow"
        },
        {
          "action": "gh_grep*",
          "resource": "*",
          "effect": "allow"
        },
        {
          "action": "playwright_*",
          "resource": "*",
          "effect": "allow"
        },
        {
          "action": "webfetch",
          "resource": "*",
          "effect": "allow"
        },
        {
          "action": "skill",
          "resource": "research-philosophy",
          "effect": "allow"
        },
        {
          "action": "shell",
          "resource": "gh repo view*",
          "effect": "allow"
        },
        {
          "action": "shell",
          "resource": "gh pr view*",
          "effect": "allow"
        },
        {
          "action": "shell",
          "resource": "gh pr list*",
          "effect": "allow"
        },
        {
          "action": "shell",
          "resource": "gh issue view*",
          "effect": "allow"
        },
        {
          "action": "shell",
          "resource": "gh issue list*",
          "effect": "allow"
        },
        {
          "action": "shell",
          "resource": "gh release view*",
          "effect": "allow"
        },
        {
          "action": "shell",
          "resource": "gh release list*",
          "effect": "allow"
        },
        {
          "action": "shell",
          "resource": "gh run view*",
          "effect": "allow"
        },
        {
          "action": "shell",
          "resource": "gh run list*",
          "effect": "allow"
        },
        {
          "action": "shell",
          "resource": "gh workflow list*",
          "effect": "allow"
        },
        {
          "action": "shell",
          "resource": "gh search *",
          "effect": "allow"
        },
        {
          "action": "shell",
          "resource": "gh api *",
          "effect": "ask"
        },
        {
          "action": "shell",
          "resource": "npm view*",
          "effect": "allow"
        },
        {
          "action": "shell",
          "resource": "npm info*",
          "effect": "allow"
        },
        {
          "action": "shell",
          "resource": "npm show*",
          "effect": "allow"
        },
        {
          "action": "shell",
          "resource": "pip show*",
          "effect": "allow"
        },
        {
          "action": "shell",
          "resource": "pip index*",
          "effect": "allow"
        },
        {
          "action": "shell",
          "resource": "cargo search*",
          "effect": "allow"
        },
        {
          "action": "shell",
          "resource": "cargo info*",
          "effect": "allow"
        }
      ]
    },
