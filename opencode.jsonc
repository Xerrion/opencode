{
  "$schema": "https://opencode.ai/config.json",
  "mcp": {
    "servicenow": {
      "type": "local",
      "command": ["uv", "run", "--directory", "/Users/lasn/Projects/servicenow-platform-mcp", "servicenow-platform-mcp"],
      "environment": {
        "SERVICENOW_INSTANCE_URL": "{env:SERVICENOW_MCP_DEV_INSTANCE_URL}",
        "SERVICENOW_API_KEY": "{env:SERVICENOW_MCP_DEV_API_KEY}",
        // "SERVICENOW_USERNAME": "{env:SERVICENOW_MCP_USERNAME}",
        // "SERVICENOW_PASSWORD": "{env:SERVICENOW_MCP_DEV_PASSWORD}",
        "MCP_TOOL_PACKAGE": "{env:SERVICENOW_MCP_TOOL_PACKAGE}",
        "SERVICENOW_ENV": "{env:SERVICENOW_MCP_DEV_ENV}",
        "SCRIPT_ALLOWED_ROOT": "/Users/lasn/Projects/servicenow-development/"
      },
      "enabled": true
    },
    "context7": {
      "type": "remote",
      "url": "https://mcp.context7.com/mcp",
      "enabled": true,
      "timeout": 10000
    },
    "exa": {
      "type": "remote",
      "url": "https://mcp.exa.ai/mcp",
      "enabled": true,
      "timeout": 10000
    },
    "gh_grep": {
      "type": "remote",
      "url": "https://mcp.grep.app",
      "enabled": true,
      "timeout": 10000
    },
    "playwright": {
      "type": "local",
      "command": [
        "mise",
        "exec",
        "--",
        "npx",
        "-y",
        "@playwright/mcp@latest",
        "--headless",
        "--isolated",
        "--browser=chromium",
        "--block-service-workers",
        "--image-responses=omit",
        "--output-dir=/tmp/playwright-mcp-research"
      ],
      "enabled": true
    },
    "pdf-reader": {
      "type": "local",
      "command": ["uvx", "pdf-mcp"],
      "enabled": true
    },
    "atlassian": {
      "type": "remote",
      "url": "https://mcp.atlassian.com/v2/mcp",
      "enabled": true
    }
  },
  "lsp": {
    "pyright": {
      "disabled": true
    },
    "basedpyright": {
      "command": ["basedpyright-langserver", "--stdio"],
      "extensions": [".py", ".pyi"]
    }
  },
  "plugin": ["@plannotator/opencode@0.25.1", "@franlol/opencode-md-table-formatter@0.0.6"],
  "permission": {
    "read": "allow",
    "glob": "allow",
    "grep": "allow",
    "edit": "ask",
    "write": "ask",
    "bash": {
      "*": "ask",
      "rm *": "deny",
      "rm.exe *": "deny",
      "del *": "deny",
      "del.exe *": "deny",
      "erase *": "deny",
      "erase.exe *": "deny",
      "rmdir *": "deny",
      "rmdir.exe *": "deny",
      "rd *": "deny",
      "Remove-Item*": "deny",
      "remove-item*": "deny",
      "sudo *": "deny",
      "sudo.exe *": "deny",
      "doas *": "deny",
      "doas.exe *": "deny",
      "su *": "deny",
      "shutdown*": "deny",
      "shutdown.exe*": "deny",
      "reboot*": "deny",
      "Restart-Computer*": "deny",
      "restart-computer*": "deny",
      "Stop-Computer*": "deny",
      "stop-computer*": "deny",
      "poweroff*": "deny",
      "halt*": "deny",
      "systemctl poweroff*": "deny",
      "systemctl reboot*": "deny",
      "git push*": "deny",
      "git.exe push*": "deny",
      "git * push*": "deny",
      "git.exe * push*": "deny",
      "git *alias.*": "deny",
      "git.exe *alias.*": "deny",
      "git-push*": "deny",
      "git -C * push*": "deny",
      "git.exe -C * push*": "deny",
      "git --git-dir* push*": "deny",
      "git.exe --git-dir* push*": "deny",
      "git push --force*": "deny",
      "git reset --hard*": "deny",
      "git reset *--hard*": "deny",
      "git * reset *--hard*": "deny",
      "git.exe reset *--hard*": "deny",
      "git.exe * reset *--hard*": "deny",
      "git-reset *--hard*": "deny",
      "git -C * reset *--hard*": "deny",
      "git.exe -C * reset *--hard*": "deny",
      "git --git-dir* reset *--hard*": "deny",
      "git.exe --git-dir* reset *--hard*": "deny"
    },
    "wow-api-lookup": "ask",
    "wow-wiki-fetch": "ask",
    "wow-event-info": "ask",
    "wow-blizzard-source": "ask",
    "task": "ask",
    "webfetch": "ask",
    "context7_*": "ask",
    "exa_*": "ask",
    "playwright_*": "ask",
    "pdf-reader_*": "ask",
    "serena_*": "ask",
    "headroom_*": "ask",
    "submit_plan": "ask",
    "external_directory": {
      "C:\\Users\\lasn\\.plannotator\\**": "allow",
      "C:\\Users\\lasn\\.local\\share\\wow-annotations\\**": "allow",
      "C:\\Users\\lasn\\Projects\\**": "allow",
      "C:\\Users\\lasn\\AppData\\Local\\Temp\\**": "allow",
      "C:\\Users\\xerrion\\.local\\share\\wow-annotations\\**": "allow",
      "C:\\Users\\xerrion\\.local\\share\\wow-framexml\\**": "allow"
    }
  },
  "agent": {
    "general": {
      "disable": true
    }
  },
  "instructions": ["./AGENTS.md"],
  "provider": {
    "headroom": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "Headroom Proxy",
      "options": {
        "baseURL": "http://127.0.0.1:8787/v1"
      },
      "models": {
        "gpt-4o": {
          "name": "GPT-4o",
          "limit": {
            "context": 128000,
            "output": 16384
          }
        },
        "gpt-4.1": {
          "name": "GPT-4.1",
          "limit": {
            "context": 1048576,
            "output": 32768
          }
        }
      }
    }
  }
}
