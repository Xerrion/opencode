{
  "$schema": "https://opencode.ai/config.json",
  "mcp": {
    "servicenow": {
      "type": "local",
      "command": [
        "uv",
        "run",
        "--directory",
        "/Users/lasn/Projects/servicenow-platform-mcp",
        "servicenow-platform-mcp"
      ],
      "environment": {
        "SERVICENOW_INSTANCE_URL": "{env:SERVICENOW_MCP_DEV_INSTANCE_URL}",
        "SERVICENOW_API_KEY": "{env:SERVICENOW_MCP_DEV_API_KEY}",
        "MCP_TOOL_PACKAGE": "{env:SERVICENOW_MCP_TOOL_PACKAGE}",
        "SERVICENOW_ENV": "{env:SERVICENOW_MCP_DEV_ENV}",
        "SENTRY_DSN": "{env:SERVICENOW_SENTRY_DSN}"
      },
      "enabled": true,
      "timeout": 10000
    },
    "context7": {
      "type": "remote",
      "url": "https://mcp.context7.com/mcp",
      "enabled": true,
      "timeout": 10000
    },
    "exa": {
      "type": "remote",
      "url": "https://mcp.exa.ai/mcp",
      "enabled": true,
      "timeout": 10000
    },
    "playwright": {
      "type": "local",
      "command": [
        "bunx",
        "-y",
        "@playwright/mcp@latest",
        "--headless",
        "--isolated",
        "--browser=chromium",
        "--block-service-workers",
        "--image-responses=omit"
      ],
      "enabled": true
    },
    "pdf_reader": {
      "type": "local",
      "command": [
        "uvx",
        "pdf-mcp"
      ],
      "enabled": true
    }
  },
  "lsp": {
    "pyright": {
      "disabled": true
    },
    "basedpyright": {
      "command": [
        "basedpyright-langserver",
        "--stdio"
      ],
      "extensions": [
        ".py",
        ".pyi"
      ]
    }
  },
  "permission": {
    "read": "allow",
    "glob": "allow",
    "grep": "allow",
    "edit": "ask",
    "write": "ask",
    "bash": {
      "*": "ask",
      "rm *": "deny",
      "rm.exe *": "deny",
      "del *": "deny",
      "del.exe *": "deny",
      "erase *": "deny",
      "erase.exe *": "deny",
      "rmdir *": "deny",
      "rmdir.exe *": "deny",
      "rd *": "deny",
      "Remove-Item*": "deny",
      "remove-item*": "deny",
      "sudo *": "deny",
      "sudo.exe *": "deny",
      "doas *": "deny",
      "doas.exe *": "deny",
      "su *": "deny",
      "shutdown*": "deny",
      "shutdown.exe*": "deny",
      "reboot*": "deny",
      "Restart-Computer*": "deny",
      "restart-computer*": "deny",
      "Stop-Computer*": "deny",
      "stop-computer*": "deny",
      "poweroff*": "deny",
      "halt*": "deny",
      "systemctl poweroff*": "deny",
      "systemctl reboot*": "deny",
      "git*": "deny"
    },
    "wow-api-lookup": "ask",
    "wow-wiki-fetch": "ask",
    "wow-event-info": "ask",
    "wow-blizzard-source": "ask",
    "task": "ask",
    "webfetch": "ask",
    "context7_*": "ask",
    "exa_*": "ask",
    "playwright_*": "ask",
    "pdf_reader_*": "ask",
    "serena_*": "ask",
    "headroom_*": "ask",
    "submit_plan": "ask",
    "external_directory": {
      "/Users/lasn/.plannotator/**": "allow",
      "/Users/lasn/.local/share/wow-annotations/**": "allow",
      "/Users/lasn/Projects/**": "allow",
      "/tmp/**": "allow",
      "/Users/lasn/.local/share/wow-framexml/**": "allow"
    }
  },
  "agent": {
    "general": {
      "disable": true
    },
    "accountant": {
      "permission": {
        "*": "deny",
        "read": "allow",
        "glob": "allow",
        "grep": "allow",
        "firefly_iii_*": "allow",
        "pdf_reader_*": "allow",
        "context7_*": "allow",
        "exa_*": "allow",
        "gh_grep*": "allow",
        "webfetch": "allow",
        "bash": {
          "*": "deny",
          "cat *": "allow",
          "head *": "allow",
          "tail *": "allow",
          "rg *": "allow",
          "grep *": "allow",
          "jq *": "allow",
          "awk *": "allow",
          "sed *": "allow",
          "find *": "allow",
          "wc *": "allow",
          "sort *": "allow",
          "uniq *": "allow",
          "cut *": "allow",
          "diff *": "allow",
          "python3 *": "ask"
        },
        "skill": {
          "*": "deny",
          "accounting-philosophy": "allow"
        },
        "submit_plan": "allow"
      }
    },
    "agil-refinement": {
      "permission": {
        "*": "deny",
        "read": "allow",
        "edit": "allow",
        "glob": "allow",
        "grep": "allow",
        "atlassian_*": "allow",
        "skill": {
          "*": "deny",
          "writing-philosophy": "allow"
        }
      }
    },
    "build": {
      "permission": {
        "read": {
          "*": "deny",
          ".deliverables/**": "allow"
        },
        "glob": {
          "*": "deny",
          ".deliverables/**": "allow"
        },
        "grep": {
          "*": "deny",
          ".deliverables/**": "allow"
        },
        "edit": "deny",
        "write": "deny",
        "bash": "deny",
        "task": {
          "*": "allow"
        }
      }
    },
    "explore": {
      "permission": {
        "*": "deny",
        "read": "allow",
        "glob": "allow",
        "grep": "allow",
        "bash": "deny"
      }
    },
    "plan": {
      "permission": {
        "read": "allow",
        "glob": "allow",
        "grep": "allow",
        "edit": "deny",
        "write": "deny",
        "bash": "deny",
        "task": {
          "*": "deny",
          "explore": "allow",
          "researcher": "allow",
          "wow-addon": "allow"
        },
        "webfetch": "deny",
        "context7_*": "deny",
        "exa_*": "deny",
        "gh_grep*": "deny",
        "playwright_*": "deny",
        "pdf_reader_*": "deny",
        "atlassian_*": "deny",
        "servicenow_*": "deny",
        "firefly_iii_*": "deny",
        "linear_*": "deny",
        "vercel_*": "deny",
        "supabase_*": "deny",
        "wow-api-lookup": "deny",
        "wow-wiki-fetch": "deny",
        "wow-event-info": "deny",
        "wow-blizzard-source": "deny",
        "serena_*": "deny",
        "skill": {
          "*": "deny",
          "plan-protocol": "allow",
          "plan-review": "allow",
          "architecture-philosophy": "allow"
        },
        "submit_plan": "allow"
      }
    },
    "red-team": {
      "permission": {
        "*": "allow",
        "read": "allow",
        "glob": "allow",
        "grep": "allow",
        "edit": "allow",
        "write": "allow",
        "bash": "allow",
        "skill": {
          "*": "allow"
        }
      }
    },
    "researcher": {
      "permission": {
        "*": "deny",
        "context7_*": "allow",
        "exa_*": "allow",
        "gh_grep*": "allow",
        "playwright_*": "allow",
        "webfetch": "allow",
        "bash": "allow",
        "skill": {
          "*": "deny",
          "research-philosophy": "allow"
        }
      }
    },
    "reviewer": {
      "permission": {
        "*": "deny",
        "read": "allow",
        "glob": "allow",
        "grep": "allow",
        "bash": "deny",
        "skill": {
          "*": "deny",
          "review-philosophy": "allow",
          "code-philosophy": "allow",
          "frontend-philosophy": "allow",
          "architecture-philosophy": "allow"
        }
      }
    },
    "scribe": {
      "permission": {
        "*": "deny",
        "read": "allow",
        "glob": "allow",
        "grep": "allow",
        "edit": "allow",
        "write": "allow",
        "skill": {
          "*": "deny",
          "writing-philosophy": "allow",
          "pptx": "allow"
        }
      }
    },
    "servicenow": {
      "permission": {
        "*": "deny",
        "read": "allow",
        "glob": "allow",
        "grep": "allow",
        "edit": "allow",
        "write": "allow",
        "bash": {
          "*": "allow",
          "rm*": "deny",
          "del*": "deny",
          "erase*": "deny",
          "rmdir*": "deny",
          "rd*": "deny",
          "remove-item*": "deny",
          "sudo*": "deny",
          "doas*": "deny",
          "su*": "deny",
          "shutdown*": "deny",
          "reboot*": "deny",
          "restart-computer*": "deny",
          "stop-computer*": "deny",
          "poweroff*": "deny",
          "halt*": "deny",
          "systemctl poweroff*": "deny",
          "systemctl reboot*": "deny"
        },
        "webfetch": "allow",
        "servicenow_*": "allow",
        "exa_*": "allow",
        "context7_*": "allow",
        "skill": {
          "*": "allow"
        }
      }
    },
    "software-engineer": {
      "permission": {
        "*": "deny",
        "read": "allow",
        "glob": "allow",
        "grep": "allow",
        "edit": "allow",
        "write": "allow",
        "bash": {
          "*": "allow",
          "rm *": "allow",
          "rm.exe *": "allow",
          "del *": "allow",
          "del.exe *": "allow",
          "erase *": "allow",
          "erase.exe *": "allow",
          "rmdir *": "allow",
          "rmdir.exe *": "allow",
          "rd *": "allow",
          "Remove-Item*": "allow",
          "remove-item*": "allow",
          "git*": "allow",
          "sudo *": "deny",
          "sudo.exe *": "deny",
          "doas *": "deny",
          "doas.exe *": "deny",
          "su *": "deny",
          "shutdown*": "deny",
          "shutdown.exe*": "deny",
          "reboot*": "deny",
          "Restart-Computer*": "deny",
          "restart-computer*": "deny",
          "Stop-Computer*": "deny",
          "stop-computer*": "deny",
          "poweroff*": "deny",
          "halt*": "deny",
          "systemctl poweroff*": "deny",
          "systemctl reboot*": "deny"
        },
        "task": "deny",
        "playwright_*": "allow",
        "skill": {
          "*": "allow"
        }
      }
    },
    "wow-addon": {
      "permission": {
        "*": "deny",
        "read": "allow",
        "glob": "allow",
        "grep": "allow",
        "webfetch": "allow",
        "playwright_*": "allow",
        "wow-api-lookup": "allow",
        "wow-wiki-fetch": "allow",
        "wow-event-info": "allow",
        "wow-blizzard-source": "allow",
        "skill": {
          "*": "deny",
          "wow-addon-design": "allow",
          "wow-addon-toolkit": "allow",
          "wow-frame-api": "allow",
          "wow-event-handling": "allow",
          "wow-lua-patterns": "allow"
        }
      }
    }
  },
  "instructions": [
    "./AGENTS.md"
  ],
  "provider": {
    "headroom": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "Headroom Proxy",
      "options": {
        "baseURL": "http://127.0.0.1:8787/v1"
      },
      "models": {
        "gpt-4o": {
          "name": "GPT-4o",
          "limit": {
            "context": 128000,
            "output": 16384
          }
        },
        "gpt-4.1": {
          "name": "GPT-4.1",
          "limit": {
            "context": 1048576,
            "output": 32768
          }
        }
      }
    }
  }
}
