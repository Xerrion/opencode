{
  "$schema": "https://opencode.ai/config.json",
  // "provider": {
  //   "lmstudio": {
  //     "npm": "@ai-sdk/openai-compatible",
  //     "name": "LM Studio (local)",
  //     "options": {
  //       "baseURL": "http://127.0.0.1:1234/v1"
  //     },
  //     "models": {
  //       "google/gemma-4-e4b": {
  //         "name": "Gemma 4 E4B "
  //       },
  //       "google/gemma-4-12b-qat": {
  //         "name": "Gemma 4 12B QAT"
  //       },
  //       "google/gemma-4-31b": {
  //         "name": "Gemma 4 31B"
  //       },
  //       "qwen/qwen3.6-27b": {
  //         "name": "Qwen 3.6 27B"
  //       }
  //     }
  //   }
  // },
  "mcp": {
    "sonarqube": {
      // Requires: docker pull mcp/sonarqube (image must be pre-pulled)
      "type": "local",
      "command": [
        "docker",
        "run",
        "-i",
        "--rm",
        "--read-only",
        "--tmpfs",
        "/tmp:rw,noexec,nosuid,size=64m",
        "--tmpfs",
        "/app/storage:rw,noexec,nosuid,size=64m",
        "--tmpfs",
        "/etc/ssl/certs:rw,noexec,nosuid,size=8m",
        "-e",
        "SONARQUBE_TOKEN",
        "-e",
        "SONARQUBE_ORG",
        "-e",
        "SONARQUBE_CLOUD_URL",
        "-e",
        "SONARQUBE_IDE_PORT",
        "mcp/sonarqube"
      ],
      "environment": {
        "SONARQUBE_ORG": "{env:SONARQUBE_ORG}",
        "SONARQUBE_CLOUD_URL": "{env:SONARQUBE_CLOUD_URL}",
        "SONARQUBE_TOKEN": "{env:SONARQUBE_TOKEN}",
        "SONARQUBE_IDE_PORT": "{env:SONARQUBE_IDE_PORT}"
      },
      "enabled": false
    },
    "servicenow": {
      // Requires: /Users/lasn/Projects/servicenow-platform-mcp to exist (local clone)
      "type": "local",
      "command": ["uv", "run", "--directory", "/Users/lasn/Projects/servicenow-platform-mcp", "servicenow-platform-mcp"],
      "environment": {
        "SERVICENOW_INSTANCE_URL": "{env:SERVICENOW_MCP_PROD_INSTANCE_URL}",
        "SERVICENOW_USERNAME": "{env:SERVICENOW_MCP_USERNAME}",
        "SERVICENOW_PASSWORD": "{env:SERVICENOW_MCP_PROD_PASSWORD}",
        "MCP_TOOL_PACKAGE": "{env:SERVICENOW_MCP_TOOL_PACKAGE}",
        "SERVICENOW_ENV": "{env:SERVICENOW_MCP_PROD_ENV}",
        "SCRIPT_ALLOWED_ROOT": "/Users/lasn/Projects/servicenow-development/"
      },
      "enabled": true
    },
    "context7": {
      "type": "remote",
      "url": "https://mcp.context7.com/mcp",
      "enabled": true,
      "timeout": 10000
    },
    "exa": {
      "type": "remote",
      "url": "https://mcp.exa.ai/mcp",
      "enabled": true,
      "timeout": 10000
    },
    "firefly-iii": {
      // Requires: project at /Users/lasn/Projects/firefly-iii-mcp.
      // Absolute bun path used because ~/.bun/bin is not on PATH for GUI launchers.
      "type": "local",
      "command": ["bun", "run", "/Users/lasn/Projects/firefly-iii-mcp/src/index.ts"],
      "environment": {
        "FIREFLY_III_URL": "{env:FIREFLY_III_URL}",
        "FIREFLY_III_TOKEN": "{env:FIREFLY_III_TOKEN}"
      },
      "enabled": true
    },
    "gh_grep": {
      "type": "remote",
      "url": "https://mcp.grep.app",
      "enabled": true,
      "timeout": 10000
    },
    "playwright": {
      // Requires: mise + node installed (mise use -g node@lts), chromium pre-installed (npx playwright install chromium)
      "type": "local",
      "command": [
        "mise",
        "exec",
        "--",
        "npx",
        "-y",
        "@playwright/mcp@latest",
        "--headless",
        "--isolated",
        "--browser=chromium",
        "--block-service-workers",
        "--image-responses=omit",
        "--output-dir=/tmp/playwright-mcp-research"
      ],
      "enabled": true
    },
    "pdf-reader": {
      "type": "local",
      "command": ["uvx", "pdf-mcp"],
      "enabled": true
    },
    "atlassian": {
      "type": "remote",
      "url": "https://mcp.atlassian.com/v1/mcp",
      "enabled": false
    }
  },
  "lsp": {
    "pyright": {
      "disabled": true
    },
    "basedpyright": {
      // Requires: basedpyright-langserver in PATH (npm install -g basedpyright)
      "command": ["basedpyright-langserver", "--stdio"],
      "extensions": [".py", ".pyi"]
    }
  },
  "plugin": ["@plannotator/opencode@latest", "@franlol/opencode-md-table-formatter@latest"],

  // ---------------------------------------------------------------------------
  // Global permissions
  //
  // Philosophy: allow read-only / inspection operations outright, prompt ("ask")
  // for light side-effects (write, edit, webfetch), hard-deny destructive ops
  // and external MCP tools. Agents override upward as needed.
  // ---------------------------------------------------------------------------
  "permission": {
    // Filesystem — reading & globbing are always safe
    "read": "allow",
    "glob": "allow",

    // Writing/editing
    // "write" is the legacy alias for file creation; "edit" covers both create and modify.
    "edit": "deny",

    // Bash — deny by default, allow only read-only / inspection tools globally.
    // Agents that need build tools, package managers, or mutating commands opt-in.
    "bash": {
      // --- File inspection (read-only) ---
      "cat *": "allow",
      "head *": "allow",
      "tail *": "allow",
      "wc *": "allow",
      "ls *": "allow",
      "tree *": "allow",
      "find *": "allow",
      "file *": "allow",
      "stat *": "allow",
      "realpath *": "allow",
      "pwd": "allow",
      "which *": "allow",
      "echo *": "allow",
      "printf *": "allow",
      "man *": "allow",
      "tldr *": "allow",

      // --- Search & text processing ---
      "rg *": "allow",
      "grep *": "allow",
      "awk *": "allow",
      "sed *": "allow",
      "sort *": "allow",
      "uniq *": "allow",
      "cut *": "allow",
      "tr *": "allow",
      "diff *": "allow",
      "jq *": "allow",

      // --- Git (read-only) ---
      "git status*": "allow",
      "git log*": "allow",
      "git diff*": "allow",
      "git show*": "allow",
      "git blame*": "allow",
      "git branch*": "allow",
      "git ls-files*": "allow",
      "git fetch*": "allow",

      // --- Networking (read-only lookups) ---
      "dig *": "allow",
      "nslookup *": "allow",
      "whois *": "allow",
      "host *": "allow",

      // --- Hard deny: destructive / dangerous ---
      "rm *": "deny",
      "sudo *": "deny",
      "shutdown*": "deny",
      "reboot*": "deny",

      // Everything unmatched is denied — without this fallback, unlisted commands
      // (interpreters, cp, mkdir, package managers) silently fall through to allow,
      // which also makes the rm/sudo denies trivially bypassable via `bun -e`/`python3`.
      "*": "deny"
    },

    // WoW addon development
    "wow-api-lookup": "deny",
    "wow-wiki-fetch": "deny",
    "wow-event-info": "deny",
    "wow-blizzard-source": "deny",

    // Orchestration & networking
    "task": "deny",
    "webfetch": "deny",

    // MCP tools — denied globally; agents opt-in.
    // (These hit external services with real side-effects.)
    //
    // MCP credential blast radius (who can touch what when allowed):
    //   sonarqube_*    -> reviewer
    //   servicenow_*   -> servicenow
    //   context7_*     -> researcher, accountant
    //   exa_*          -> researcher, accountant
    //   gh_grep*       -> researcher, accountant
    //   playwright_*   -> researcher, software-engineer, red-team, explore, wow-addon
    //   firefly_iii_*  -> accountant            (personal-finance API; sole consumer)
    //   pdf_reader_*   -> accountant            (statement ingest)
    //   atlassian_*    -> jira
    //   linear_*       -> linear                (agent work-state tracking; sole consumer)
    // Keep this table in sync when adding/removing agent grants — it is the only
    // at-a-glance audit of which agent can reach which external service.
    "context7_*": "deny",
    "exa_*": "deny",
    "gh_grep*": "deny",
    "sonarqube_*": "deny",
    "servicenow_*": "deny",
    "playwright_*": "deny",
    "firefly_iii_*": "deny",
    "pdf_reader_*": "deny",
    "atlassian_*": "deny",
    "linear_*": "deny",

    // Skills - deny by default. Each agent opts in to the specific skills it owns.
    // Skill ownership is per-agent; the build orchestrator does not route skills.
    "skill": {
      "*": "deny"
    },

    "external_directory": {
      "/Users/lasn/.plannotator/**": "allow",
      "/Users/lasn/.local/share/wow-annotations/**": "allow",
      "/Users/lasn/Projects/**": "allow",
      "/tmp/**": "allow",
      // Wow addon development directories (read-only access to API references, annotations, and FrameXML source)
      "/home/xerrion/.local/share/wow-annotations/**": "allow",
      "/home/xerrion/.local/share/wow-framexml/**": "allow"
    }
  },

  // ---------------------------------------------------------------------------
  // Agents — only override what differs from the global baseline
  // ---------------------------------------------------------------------------
  "agent": {
    // Research agent: read-only, external search tools enabled
    "researcher": {
      "model": "github-copilot/gpt-5.6-sol",
      "mode": "subagent",
      "temperature": 0.2,
      "permission": {
        // No file mutation
        "edit": "deny",
        "write": "allow",
        // Enable research MCP tools
        "context7_*": "allow",
        "exa_*": "allow",
        "gh_grep*": "allow",
        "playwright_*": "allow",
        "webfetch": "allow",
        "skill": {
          "*": "allow"
        },
        // Bash: inherits global read-only tools, add GitHub CLI read ops
        "bash": {
          "gh repo view*": "allow",
          "gh pr view*": "allow",
          "gh pr list*": "allow",
          "gh issue view*": "allow",
          "gh issue list*": "allow",
          "gh release view*": "allow",
          "gh release list*": "allow",
          "gh run view*": "allow",
          "gh run list*": "allow",
          "gh workflow list*": "allow",
          "gh search *": "allow",
          "gh api *": "allow",
          "npm view*": "allow",
          "npm info*": "allow",
          "npm show*": "allow",
          "pip show*": "allow",
          "pip index*": "allow",
          "cargo search*": "allow",
          "cargo info*": "allow"
        }
      }
    },

    // Personal accounting / Firefly III agent (read-mostly, PDF ingest for statements)
    "accountant": {
      "model": "github-copilot/gpt-5.6-sol",
      "mode": "primary",
      "temperature": 0.2,
      "color": "#2e8b57",
      "permission": {
        "edit": "deny",
        "webfetch": "allow",
        "firefly_iii_*": "allow",
        "context7_*": "allow",
        "exa_*": "allow",
        "gh_grep*": "allow",
        "pdf-reader*": "allow",
        // Bash inherits the global read-only allowlist. Python enables CSV parsing and
        // exact Decimal-based reconciliation calculations; accountant policy prohibits
        // file writes, subprocesses, network access, or package installation.
        "bash": {
          "python3 *": "allow"
        },
        "skill": { "accounting-philosophy": "allow" }
      }
    },

    // Documentation / prose writer
    "scribe": {
      "model": "github-copilot/gpt-5.6-terra",
      "mode": "subagent",
      "temperature": 0.3,
      "permission": {
        "edit": "allow",
        "skill": {
          "writing-philosophy": "allow",
          "pptx": "allow"
        },
        // No bash at all
        "bash": { "*": "deny" }
      }
    },

    // Full-featured coding agent
    "software-engineer": {
      "model": "github-copilot/claude-fable-5",
      "mode": "subagent",
      "variant": "medium",
      "temperature": 0.3,
      "permission": {
        "write": "allow",
        "read": "allow",
        "edit": "allow",
        "playwright_*": "allow",
        // Skills the software-engineer is allowed to load. Domain skills (WoW, ServiceNow)
        // are intentionally excluded — those live with their domain agents and are loaded
        // there before any delegation reaches the SE.
        "skill": {
          "code-philosophy": "allow",
          "frontend-philosophy": "allow",
          "architecture-philosophy": "allow",
          "implementation-philosophy": "allow",
          "mcp-builder": "allow",
          "pptx": "allow"
        },
        // SE owns git, gh, and the full project toolchain (build/lint/test across any
        // stack), so the bash grant is intentionally broad. Destructive commands are
        // still blocked by the global `rm */sudo *` denies.
        "bash": {
          "*": "allow"
        }
      }
    },

    // Direct, end-to-end implementation owner. Unlike software-engineer, this
    // primary agent may make research, documentation, and architecture decisions
    // itself and is responsible for invoking reviewer after every file change.
    "autonomous-engineer": {
      "model": "openai/gpt-5.6-terra",
      "mode": "primary",
      "variant": "medium",
      "temperature": 0.3,
      "permission": {
        "write": "allow",
        "read": "allow",
        "edit": "allow",
        "task": "deny",
        "playwright_*": "allow",
        "context7_*": "allow",
        "exa_*": "allow",
        "gh_grep*": "allow",
        "webfetch": "allow",
        "skill": {
          "code-philosophy": "allow",
          "frontend-philosophy": "allow",
          "architecture-philosophy": "allow",
          "implementation-philosophy": "allow",
          "writing-philosophy": "allow",
          "research-philosophy": "allow",
          "code-review": "allow",
          "review-philosophy": "allow",
          "mcp-builder": "allow",
          "pptx": "allow"
        },
        "bash": {
          "*": "allow"
        }
      }
    },

    // Adversarial security red-team (full executor, on-demand only)
    "red-team": {
      "model": "github-copilot/gpt-5.6-sol",
      "mode": "subagent",
      "variant": "medium",
      "temperature": 0.2,
      "color": "#8B0000",
      "permission": {
        "edit": "allow",
        "playwright_*": "allow",
        "skill": {
          "code-philosophy": "allow",
          "frontend-philosophy": "allow",
          "architecture-philosophy": "allow"
        },
        "bash": {
          "*": "allow"
        }
      }
    },

    // Code reviewer & refactoring analyst (read-only)
    "reviewer": {
      "model": "github-copilot/gpt-5.6-sol",
      "mode": "subagent",
      "temperature": 0.1,
      "permission": {
        "edit": "deny",
        "sonarqube_*": "allow",
        "skill": {
          "code-philosophy": "allow",
          "frontend-philosophy": "allow",
          "architecture-philosophy": "allow",
          "code-review": "allow",
          "review-philosophy": "allow",
          "mcp-builder": "allow"
        }
      }
    },

    // Task orchestrator / planner
    "plan": {
      "model": "github-copilot/gpt-5.6-terra",
      "mode": "primary",
      "temperature": 0.3,
      "permission": {
        "edit": "deny",
        "bash": { "*": "deny" },
        "task": "allow",
        "submit_plan": "allow",
        "skill": {
          "plan-protocol": "allow",
          "plan-review": "allow",
          "architecture-philosophy": "allow"
        }
      }
    },

    // Build orchestrator
    "build": {
      "model": "github-copilot/gpt-5.6-terra",
      "mode": "primary",
      "permission": {
        // Scoped exception: subagents write findings under .deliverables/ for build to read directly.
        "read": { ".deliverables/**": "allow", "*": "deny" },
        "glob": { ".deliverables/**": "allow", "*": "deny" },

        "bash": { "*": "deny" },
        "task": "allow"
      }
    },

    // Filesystem & repo explorer (strictly read-only; chat-only pointer summaries)
    "explore": {
      "model": "github-copilot/gpt-5.6-luna",
      "mode": "subagent",
      "temperature": 0.2,
      "permission": {
        "edit": "deny",
        "playwright_*": "allow",
        "bash": {
          "docker inspect*": "allow"
        }
      }
    },

    // WoW addon reference agent (read-only + external APIs)
    "wow-addon": {
      "model": "github-copilot/gpt-5.6-terra",
      "mode": "subagent",
      "temperature": 0.1,
      "color": "#C79C6E",
      "permission": {
        "edit": "deny",
        "write": "deny",
        "bash": { "*": "deny" },
        "webfetch": "allow",
        "playwright_*": "allow",
        "wow-*": "allow",
        "wow-api-lookup": "allow",
        "wow-wiki-fetch": "allow",
        "wow-event-info": "allow",
        "wow-blizzard-source": "allow",
        "task": { "*": "deny" },
        "skill": {
          "wow-addon-design": "allow",
          "wow-addon-toolkit": "allow",
          "wow-frame-api": "allow",
          "wow-event-handling": "allow",
          "wow-lua-patterns": "allow"
        }
      }
    },

    // Jira / Atlassian operator
    "jira": {
      "model": "github-copilot/gpt-5.6-luna",
      "mode": "primary",
      "temperature": 0.2,
      "color": "#2684ff",
      "permission": {
        "edit": "deny",
        "bash": { "*": "deny" },
        "webfetch": "deny",
        "atlassian_*": "allow",
        "skill": {
          "writing-philosophy": "allow"
        }
      }
    },

    // Linear tracker subagent (agent work-state recording; sole linear_* consumer)
    "linear": {
      "model": "github-copilot/gpt-5.6-luna",
      "mode": "subagent",
      "temperature": 0.1,
      "permission": {
        "edit": "deny",
        "bash": { "*": "deny" },
        "webfetch": "deny",
        "linear_*": "allow"
      }
    },

    // ServiceNow platform API agent
    "servicenow": {
      "model": "github-copilot/gpt-5.6-sol",
      "mode": "primary",
      "temperature": 0.1,
      "color": "#0070d2",
      "permission": {
        "edit": "allow",
        "bash": { "*": "deny" },
        "task": "allow",
        "webfetch": "deny",
        "servicenow_*": "allow",
        "skill": {
          "servicenow-mcp-reference": "allow",
          "servicenow-scripting": "allow",
          "servicenow-business-rules": "allow",
          "servicenow-client-scripts": "allow",
          "servicenow-gliderecord": "allow"
        }
      }
    },

    "general": {
      "disable": true
    },

    // Tech Lead/Architect advisor (writes ADR briefs to .deliverables/tech-lead/)
    "tech-lead": {
      "model": "github-copilot/gpt-5.6-sol",
      "mode": "subagent",
      "temperature": 0.2,
      "permission": {
        "edit": "allow",
        "write": "allow",
        "webfetch": "allow",
        // Per agents/tech-lead.md §skills: architecture-philosophy always, code-philosophy
        // and wow-addon-design conditionally. No broader skill access is justified.
        "skill": {
          "architecture-philosophy": "allow",
          "code-philosophy": "allow",
          "wow-addon-design": "allow"
        }
      }
    }
  },

  "instructions": ["./AGENTS.md"],
  "compaction": {
    "prune": false
  },
  "provider": {
    "copilot": {
      "options": {
        "headers": {
          "sleeve-provider": "copilot",
          "sleeve-harness": "opencode"
        },
        "baseURL": "http://127.0.0.1:17321"
      }
    }
  }
}
