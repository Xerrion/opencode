{
  "$schema": "https://opencode.ai/config.json",
  "mcp": {
    "context7": {
      "type": "remote",
      "url": "https://mcp.context7.com/mcp",
      "enabled": true,
      "timeout": 10000
    },
    "exa": {
      "type": "remote",
      "url": "https://mcp.exa.ai/mcp",
      "enabled": true,
      "timeout": 10000
    },
    "playwright": {
      "type": "local",
      "command": [
        "bunx",
        "-y",
        "@playwright/mcp@latest",
        "--headless",
        "--isolated",
        "--browser=chromium",
        "--block-service-workers",
        "--image-responses=omit"
      ],
      "enabled": true
    },
    "pdf-reader": {
      "type": "local",
      "command": [
        "uvx",
        "pdf-mcp"
      ],
      "enabled": true
    }
  },
  "lsp": {
    "pyright": {
      "disabled": true
    },
    "basedpyright": {
      "command": [
        "basedpyright-langserver",
        "--stdio"
      ],
      "extensions": [
        ".py",
        ".pyi"
      ]
    }
  },
  "permission": {
    "read": "allow",
    "glob": "allow",
    "grep": "allow",
    "edit": "ask",
    "write": "ask",
    "bash": {
      "*": "ask",
      "rm *": "deny",
      "rm.exe *": "deny",
      "del *": "deny",
      "del.exe *": "deny",
      "erase *": "deny",
      "erase.exe *": "deny",
      "rmdir *": "deny",
      "rmdir.exe *": "deny",
      "rd *": "deny",
      "Remove-Item*": "deny",
      "remove-item*": "deny",
      "sudo *": "deny",
      "sudo.exe *": "deny",
      "doas *": "deny",
      "doas.exe *": "deny",
      "su *": "deny",
      "shutdown*": "deny",
      "shutdown.exe*": "deny",
      "reboot*": "deny",
      "Restart-Computer*": "deny",
      "restart-computer*": "deny",
      "Stop-Computer*": "deny",
      "stop-computer*": "deny",
      "poweroff*": "deny",
      "halt*": "deny",
      "systemctl poweroff*": "deny",
      "systemctl reboot*": "deny",
      "git*": "deny"
    },
    "wow-api-lookup": "ask",
    "wow-wiki-fetch": "ask",
    "wow-event-info": "ask",
    "wow-blizzard-source": "ask",
    "task": "ask",
    "webfetch": "ask",
    "context7_*": "ask",
    "exa_*": "ask",
    "playwright_*": "ask",
    "pdf-reader_*": "ask",
    "serena_*": "ask",
    "headroom_*": "ask",
    "submit_plan": "ask",
    "external_directory": {
      "C:\\Users\\lasn\\.plannotator\\**": "allow",
      "C:\\Users\\lasn\\.local\\share\\wow-annotations\\**": "allow",
      "C:\\Users\\lasn\\Projects\\**": "allow",
      "C:\\Users\\lasn\\AppData\\Local\\Temp\\**": "allow",
      "C:\\Users\\xerrion\\.local\\share\\wow-annotations\\**": "allow",
      "C:\\Users\\xerrion\\.local\\share\\wow-framexml\\**": "allow"
    }
  },
  "agent": {
    "general": {
      "disable": true
    }
  },
  "instructions": [
    "./AGENTS.md"
  ],
  "provider": {
    "headroom": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "Headroom Proxy",
      "options": {
        "baseURL": "http://127.0.0.1:8787/v1"
      },
      "models": {
        "gpt-4o": {
          "name": "GPT-4o",
          "limit": {
            "context": 128000,
            "output": 16384
          }
        },
        "gpt-4.1": {
          "name": "GPT-4.1",
          "limit": {
            "context": 1048576,
            "output": 32768
          }
        }
      }
    }
  }
}
